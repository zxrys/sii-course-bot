# 填写后才可开启飞书；本地同步、查询不需要这些配置。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须明确配置本人 open_id（ou_...）；未配置时机器人不处理任何人的消息。
FEISHU_OWNER_OPEN_ID=
REMINDER_MINUTES=30
SYNC_INTERVAL_HOURS=24
# 超过此时长仍未成功同步时，停止课程提醒并报告同步异常。
MAX_SCHEDULE_AGE_HOURS=48
# 安装了 Chrome 时保持 chrome；使用 Playwright Chromium 时改为 chromium。
BROWSER_CHANNEL=chrome
